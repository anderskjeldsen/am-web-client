namespace Am.Web.Client
{
    // One HTTP answer, as data.
    class AsyncHttpAnswer(var status: Int, var statusMessage: String,
                          var body: String, var error: String) {
        import Am.Lang

        // Filled instead of `body` when bytes were asked for.
        var bodyBytes: UByte[]? = null

        fun isSuccess(): Bool {
            var ok = false
            if (this.error == null || this.error.length() == 0) {
                ok = this.status >= 200 && this.status < 300
            }
            return ok
        }
    }

    // One request, and the slot its answer goes into. A plain object: the
    // host's dispatch hook fills in `answer` before it resumes the caller.
    class AsyncHttpRequest(var method: String, var url: String, var body: String,
                           var wantBytes: Bool) {
        import Am.Lang
        import Am.Collections

        var headers: HashMap<String, String> = new HashMap<String, String>()

        // The host hands this back to deliver(); it is what finds the
        // suspended caller again.
        var ticket: Int = 0
    }

    // How a library makes an HTTP request without knowing what kind of
    // program it is in.
    //
    // With no hook installed the request BLOCKS, which is right nearly
    // everywhere: a command-line tool has nothing else to do, and a worker
    // thread exists to wait. An application with a window installs a hook
    // that hands the work to a worker and delivers the answer later.
    //
    // THE SHAPE IS NOT NEGOTIABLE, and each rule below was established by
    // a failing three-class repro:
    //
    //   - The host does NOT override a suspend method. An `override
    //     suspend fun` that suspends resumes into the BASE class's body,
    //     with the frame as the base expects it -- in the studio that came
    //     out as the blocking path trying to resolve a host called "POST",
    //     because the arguments had shifted by one.
    //   - The hook does NOT receive the Continuation. Passing one through
    //     a function-typed field segfaults. The continuation stays HERE,
    //     in a map keyed by a ticket, and the hook gets only the request.
    //   - The host does NOT write the answer onto the request object. A
    //     lambda captures by value, so a field write inside the host's
    //     callback lands on a copy. It calls deliver() instead.
    //
    // The hook is a static, so it is per isolate: Main gets whatever the
    // application installed, a worker gets the blocking path without
    // anyone arranging it.
    class AsyncTransport {
        import Am.Lang
        import Am.Collections
        import Am.Async

        // Installed by the host. Gets the request and nothing else; the
        // answer comes back through deliver().
        static var dispatch: ((req: AsyncHttpRequest) => Bool)? = null

        private static var pending: HashMap<Int, Continuation> = new HashMap<Int, Continuation>()
        private static var answers: HashMap<Int, AsyncHttpAnswer> = new HashMap<Int, AsyncHttpAnswer>()
        private static var nextTicket: Int = 1

        // `method` is "GET" or "POST". Never throws: a transport failure
        // comes back in the answer's `error`, because the caller is usually
        // a suspend function whose exception path is the awkward one.
        static suspend fun request(method: String, url: String, body: String,
                                   headers: HashMap<String, String>,
                                   wantBytes: Bool): AsyncHttpAnswer {
            var hook = AsyncTransport.dispatch
            if (hook == null) {
                return AsyncTransport.blocking(method, url, body, headers, wantBytes)
            }
            var req = new AsyncHttpRequest(method, url, body, wantBytes)
            req.headers = headers
            req.ticket = AsyncTransport.nextTicket
            AsyncTransport.nextTicket = AsyncTransport.nextTicket + 1
            suspend(cont) {
                AsyncTransport.pending.set(req.ticket, cont)
                hook(req)
            }
            var answer = AsyncTransport.take(req.ticket)
            if (answer == null) {
                return new AsyncHttpAnswer(0, "", "",
                    "the host's transport resumed without an answer")
            }
            return answer as AsyncHttpAnswer
        }

        // Called by the host when the request is done.
        static fun deliver(ticket: Int, answer: AsyncHttpAnswer) {
            AsyncTransport.answers.set(ticket, answer)
            AsyncTransport.resume(ticket)
        }

        private static fun take(ticket: Int): AsyncHttpAnswer? {
            if (!AsyncTransport.answers.containsKey(ticket)) {
                return null
            }
            var a = AsyncTransport.answers.get(ticket)
            AsyncTransport.answers.remove(ticket)
            return a
        }

        private static fun resume(ticket: Int) {
            if (!AsyncTransport.pending.containsKey(ticket)) {
                return
            }
            var cont = AsyncTransport.pending.get(ticket)
            AsyncTransport.pending.remove(ticket)
            cont.resume()
        }

        // What runs when nobody installed a hook.
        static fun blocking(method: String, url: String, body: String,
                            headers: HashMap<String, String>,
                            wantBytes: Bool): AsyncHttpAnswer {
            var answer = new AsyncHttpAnswer(0, "", "", "")
            try {
                var client = new WebClient()
                var resp: HttpResponse? = null
                if (method.equals("POST")) {
                    resp = client.postWithHeaders(url, body, headers)
                } else if (wantBytes) {
                    resp = client.getBytesWithHeaders(url, headers)
                } else {
                    resp = client.getWithHeaders(url, headers)
                }
                if (resp == null) {
                    answer.error = "No response from " + url
                } else {
                    var r = resp as HttpResponse
                    answer.status = r.getStatusCode()
                    answer.statusMessage = r.getStatusMessage()
                    if (wantBytes) {
                        answer.bodyBytes = r.getBodyAsBytes()
                    } else {
                        var s = r.getBodyAsString()
                        if (s != null) {
                            answer.body = s
                        }
                    }
                }
            } catch (e: Exception) {
                var m = e.message
                if (m == null || m.length() == 0) {
                    m = "The request could not be sent."
                }
                answer.error = m
            }
            return answer
        }
    }
}
